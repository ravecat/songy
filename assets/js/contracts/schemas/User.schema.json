{
  "type": "object",
  "description": "JSON-encoded user",
  "required": ["id", "name", "avatar_url"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "name": {
      "type": "string"
    },
    "avatar_url": {
      "type": "string",
      "format": "uri"
    }
  },
  "additionalProperties": false
}
