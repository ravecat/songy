{
  "type": "module",
  "workspaces": [
    "../deps/*"
  ],
  "scripts": {
    "test": "vitest run --reporter=verbose",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "test:unit": "vitest run --project unit --reporter=verbose",
    "test:browser": "vitest run --project browser --reporter=verbose",
    "test:coverage": "vitest run --coverage",
    "check": "svelte-check",
    "check:watch": "svelte-check --watch",
    "typecheck": "tsc --noEmit",
    "e2e:install": "playwright install",
    "e2e:run": "playwright test",
    "e2e:fast": "playwright test --reporter=list",
    "e2e:ui": "playwright test --ui",
    "e2e:watch": "playwright test --ui"
  },
  "dependencies": {
    "@inertiajs/svelte": "^2.3.12",
    "@types/spotify-web-playback-sdk": "^0.1.19",
    "axios": "^1.13.4",
    "clsx": "^2.1.1",
    "es-toolkit": "^1.44.0",
    "lucide-svelte": "^0.563.0",
    "phoenix": "workspace:*",
    "phoenix_html": "workspace:*",
    "phoenix_live_view": "workspace:*",
    "redaxios": "^0.5.1",
    "svelte": "^5.49.0",
    "tailwind-merge": "^3.4.0",
    "topbar": "^3.0.0",
    "vite-plugin-es-toolkit": "^1.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@rvct/asyncapi-codegen": "0.2.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.3.1",
    "@tsconfig/svelte": "^5.0.6",
    "@types/phoenix": "^1.6.7",
    "@vitest/browser-playwright": "^4.0.18",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "daisyui": "^5.5.14",
    "jsdom": "^27.4.0",
    "rollup-plugin-visualizer": "^6.0.5",
    "svelte-check": "^4.3.5",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "typescript-svelte-plugin": "^0.3.49",
    "vite": "^7.3.1",
    "vitest": "^4.0.18",
    "vitest-browser-svelte": "^2.0.2"
  }
}
