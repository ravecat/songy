{
  "type": "module",
  "workspaces": [
    "../deps/*"
  ],
  "scripts": {
    "test:ui": "vitest --ui",
    "test:run": "vitest run --reporter=verbose",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "check": "svelte-check",
    "check:watch": "svelte-check --watch",
    "typecheck": "tsc --noEmit",
    "e2e:install": "playwright install",
    "e2e:run": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:watch": "playwright test --watch"
  },
  "dependencies": {
    "@inertiajs/svelte": "^2.0.14",
    "@types/spotify-web-playback-sdk": "^0.1.19",
    "axios": "^1.9.0",
    "clsx": "^2.1.1",
    "lucide-svelte": "^0.563.0",
    "phoenix": "workspace:*",
    "phoenix_html": "workspace:*",
    "phoenix_live_view": "workspace:*",
    "pixi.js": "^8.14.3",
    "svelte": "^5.41.0",
    "svelte-dnd-action": "^0.9.64",
    "tailwind-merge": "^3.4.0",
    "topbar": "^3.0.0",
    "xstate": "^5.25.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@sveltejs/vite-plugin-svelte": "^5.1.0",
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/svelte": "^5.2.8",
    "@tsconfig/svelte": "^5.0.4",
    "@types/phoenix": "^1.6.6",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "daisyui": "^5.0.0",
    "jsdom": "^27.4.0",
    "svelte-check": "^4.3.1",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.2",
    "typescript-svelte-plugin": "^0.3.49",
    "vite": "^6.3.5",
    "vitest": "^4.0.18"
  }
}
