{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "allowJs": true,
    "noEmit": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["DOM", "DOM.Iterable", "ES6"],

    "baseUrl": ".",
    "paths": {
      "~/*": ["js/*"],
      "~hooks/*": ["js/hooks/*"],
      "~pages/*": ["js/pages/*"],
      "~components/*": ["js/components/*"],
      "~shared/*": ["js/shared/*"],
      "~types/*": ["js/shared/types/*"],
      "~mocks/*": ["__mocks__/*"]
    },
    "types": ["vite/client", "vitest"],
    "plugins": [
      {
        "name": "typescript-svelte-plugin",
        "enabled": true,
        "assumeIsSvelteProject": true
      }
    ]
  },
  "include": [
    "js/**/*.ts",
    "js/**/*.svelte",
    "tests/**/*.ts",
    "tests/**/*.js",
    "*.ts",
    "*.js",
    "*.svelte"
  ],
  "exclude": ["node_modules", "dist", "_build", "../priv"]
}
