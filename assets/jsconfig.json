{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["js/*"],
      "@hooks/*": ["js/hooks/*"],
      "@pages/*": ["js/pages/*"],
      "@components/*": ["js/components/*"],
      "@shared/*": ["js/shared/*"],
      "@mocks/*": ["__mocks__/*"]
    }
  },
  "include": ["js/**/*", "__mocks__/**/*"]
}
