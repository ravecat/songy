<div class="min-h-screen flex flex-col items-center justify-center bg-gradient-to-br from-purple-400 via-pink-500 to-red-500">
  <div class="flex-1 flex items-center justify-center">
    <div class="text-center text-white">
      <h1 class="text-4xl font-bold mb-4">Room: {@hash}</h1>
      <p class="text-lg opacity-90">Game starting soon...</p>
    </div>
  </div>

  <div class="w-full p-6">
    <div class="max-w-md mx-auto bg-white/10 backdrop-blur-sm rounded-xl p-4 text-white">
      <div class="flex items-center space-x-4">
        <img
          src={@current_user.avatar_url}
          alt="User avatar"
          class="w-12 h-12 rounded-full bg-white/20 p-1"
        />
        <div>
          <p class="font-semibold text-lg">{@current_user.name}</p>
          <p class="text-sm opacity-75">ID: {String.slice(@current_user.uuid, 0, 8)}...</p>
        </div>
      </div>
    </div>
  </div>
</div>
